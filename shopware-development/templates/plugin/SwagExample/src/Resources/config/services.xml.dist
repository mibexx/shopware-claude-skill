<?xml version="1.0" ?>
<!--
    ALTERNATIVE TO services.php (deprecated in 6.7, NO longer loaded as of 6.8.0.0).
    To use it, rename it to services.xml and then DELETE services.php:
    Bundle::registerContainerFile() loads all files via the glob "services.*".
-->
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!--
        <service id="SwagExample\Service\MyService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="SwagExample\Subscriber\MySubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        -->
    </services>
</container>
