<?xml version="1.0" ?>
<!--
    ALTERNATIVE ZU services.php (in 6.7 deprecated, wird ab 6.8.0.0 NICHT mehr geladen).
    Zum Nutzen in services.xml umbenennen und services.php dann LOESCHEN:
    Bundle::registerContainerFile() laedt alle Dateien per Glob "services.*".
-->
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!--
        <service id="SwagExample\Service\MyService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="SwagExample\Subscriber\MySubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        -->
    </services>
</container>
