{
    "_comment": "Ausschnitt, KEIN vollstaendiges Manifest (_comment entfernen). Die Tools muessen im PROJEKT installiert sein (require-dev eines Plugins wird vom Projekt-Composer nicht installiert) und PHPStan MUSS aus dem Projekt-Root laufen (aus dem Plugin-Ordner: Class ... not found). Scripts daher in der composer.json des Projekts. ⚠ UNGEPRUEFT: die Composer-Script-Huelle selbst; die darin aufgerufenen Befehle wurden einzeln ausgefuehrt.",
    "plugin composer.json": {
        "require": {
            "php": ">=8.2"
        }
    },
    "projekt composer.json": {
        "require-dev": {
            "friendsofphp/php-cs-fixer": "^3.95",
            "phpat/phpat": "^0.12",
            "phpstan/phpstan": "^2.3",
            "phpstan/phpstan-symfony": "^2.1",
            "symplify/phpstan-rules": "^14.19"
        },
        "scripts": {
            "phpstan:swag-example": "phpstan analyse -c custom/plugins/SwagExample/phpstan.neon.dist --no-progress",
            "cs-check:swag-example": "php-cs-fixer check --config=custom/plugins/SwagExample/.php-cs-fixer.dist.php custom/plugins/SwagExample",
            "cs-fix:swag-example": "php-cs-fixer fix --config=custom/plugins/SwagExample/.php-cs-fixer.dist.php custom/plugins/SwagExample"
        }
    }
}
