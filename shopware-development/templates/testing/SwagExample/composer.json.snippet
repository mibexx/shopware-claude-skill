{
    "_comment": "Excerpt, NOT a complete manifest (remove _comment). Part 1 (autoload-dev, php) belongs in custom/plugins/SwagExample/composer.json. Part 2 (require-dev, scripts) belongs in the PROJECT's composer.json: the project Composer does not install a plugin's require-dev. Scripts run from the project root.",
    "plugin composer.json": {
        "require": {
            "php": ">=8.2",
            "shopware/core": "~6.7.0"
        },
        "autoload-dev": {
            "psr-4": {
                "SwagExample\\Tests\\": "tests/"
            }
        }
    },
    "project composer.json": {
        "require-dev": {
            "shopware/dev-tools": "^1.6",
            "phpunit/phpunit": "^11.5",
            "symfony/browser-kit": "^7.4"
        },
        "scripts": {
            "test:swag-example": "phpunit --configuration custom/plugins/SwagExample/phpunit.xml.dist",
            "test:swag-example:unit": "phpunit --configuration custom/plugins/SwagExample/phpunit.xml.dist --testsuite unit"
        }
    }
}
