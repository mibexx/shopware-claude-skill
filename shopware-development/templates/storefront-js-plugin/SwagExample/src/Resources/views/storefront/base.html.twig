{% sw_extends '@Storefront/storefront/base.html.twig' %}

{# Block "base_main_inner" lives inside <main> (storefront/base.html.twig).
   ⚠ The core templates page/content/index.html.twig and page/content/product-detail.html.twig also override it;
   there the markup only takes effect if their block calls {{ parent() }}. #}
{% block base_main_inner %}
    {{ parent() }}

    <div class="container">
        <button type="button"
                class="btn btn-secondary"
                id="swag-example-toggle"
                aria-controls="swag-example-target"
                aria-expanded="false"
                data-swag-example="true"
                data-swag-example-options="{{ { activeClass: 'is-open' }|json_encode }}">
            {{ 'swagExample.toggle'|trans|sw_sanitize }}
        </button>
        <div id="swag-example-target" data-swag-example-target></div>
    </div>
{% endblock %}
