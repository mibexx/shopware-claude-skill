{
    "_comment": "Excerpt, NOT a complete manifest (remove _comment). The tools must be installed in the PROJECT (a plugin's require-dev is not installed by the project Composer) and PHPStan MUST run from the project root (from the plugin folder: Class ... not found). Hence the scripts go into the project's composer.json. ⚠ UNVERIFIED: the Composer script wrapper itself; the commands it calls were executed individually.",
    "plugin composer.json": {
        "require": {
            "php": ">=8.2"
        }
    },
    "project composer.json": {
        "require-dev": {
            "friendsofphp/php-cs-fixer": "^3.95",
            "phpat/phpat": "^0.12",
            "phpstan/phpstan": "^2.3",
            "phpstan/phpstan-symfony": "^2.1",
            "symplify/phpstan-rules": "^14.19"
        },
        "scripts": {
            "phpstan:swag-example": "phpstan analyse -c custom/plugins/SwagExample/phpstan.neon.dist --no-progress",
            "cs-check:swag-example": "php-cs-fixer check --config=custom/plugins/SwagExample/.php-cs-fixer.dist.php custom/plugins/SwagExample",
            "cs-fix:swag-example": "php-cs-fixer fix --config=custom/plugins/SwagExample/.php-cs-fixer.dist.php custom/plugins/SwagExample"
        }
    }
}
