# Path in the plugin: custom/plugins/SwagExample/phpstan.neon.dist
# Run from the project root (/var/www/html), see README.md:
#   vendor/bin/phpstan analyse -c custom/plugins/SwagExample/phpstan.neon.dist
# All paths below are relative to THIS file (plugin root in custom/plugins/SwagExample).
includes:
    # Shopware type extensions and rules (live in the package shopware/core; a separate package shopware/phpstan-extension can NOT be found on Packagist)
    - ../../../vendor/shopware/core/DevOps/StaticAnalyze/PHPStan/extension.neon
    - ../../../vendor/shopware/core/DevOps/StaticAnalyze/PHPStan/rules.neon
    # rules.neon requires PHPStan\Symfony\ParameterMap (package phpstan/phpstan-symfony) and tags phpat.test (package phpat/phpat)
    - ../../../vendor/phpstan/phpstan-symfony/extension.neon
    - ../../../vendor/phpat/phpat/extension.neon
    # rules.neon uses Symplify rules; their helper services come ONLY from services.neon. Do not use phpstan/extension-installer:
    # it includes the complete Symplify configuration and collides with rules.neon ("Multiple services of type ...NoReturnSetterMethodRule").
    - ../../../vendor/symplify/phpstan-rules/config/services/services.neon
    # If plugin development according to core rules is wanted (DecorationPatternRule among others), include deliberately and after testing (needs phpstan-symfony):
    # - ../../../vendor/shopware/core/DevOps/StaticAnalyze/PHPStan/core-rules.neon

parameters:
    level: 8
    phpVersion: 80200
    treatPhpDocTypesAsCertain: false
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: true
    paths:
        - src
        - tests
    excludePaths:
        - src/Resources
    bootstrapFiles:
        # boots the StaticAnalyzeKernel (cache: var/cache/static_phpstan_dev) and provides the project autoloader
        - ../../../vendor/shopware/core/DevOps/StaticAnalyze/phpstan-bootstrap.php
    ignoreErrors: []
    symfony:
        # container generated by phpstan-bootstrap.php (var/cache/static_phpstan_dev)
        containerXmlPath: ../../../var/cache/static_phpstan_dev/Shopware_Core_DevOps_StaticAnalyze_StaticAnalyzeKernelPhpstan_devDebugContainer.xml

    # Configuration of the Shopware rules (adopted from core/DevOps/StaticAnalyze/PHPStan/common.neon):
    # extension.neon/rules.neon alone are NOT enough, the rules need the service Configuration (see below).
    shopware:
        allowedNonDomainExceptions: []
        allowedStorefrontRouteNamespaces:
            - Shopware\Storefront
        allowedUnitTestClassNamespaces:
            - SwagExample\Tests\Unit\
        createMockWithoutExpectationsEnabledNamespaces: []

services:
    -
        factory: Shopware\Core\DevOps\StaticAnalyze\PHPStan\Configuration(%shopware%)
    -
        class: Shopware\Core\DevOps\StaticAnalyze\PHPStan\Rules\AclValidPermissionsHelper

parametersSchema:
    ?shopwareTaggedServiceContractAdditionalTagContracts: arrayOf(string(), string())
    shopware: structure([
        allowedNonDomainExceptions: list(string),
        allowedStorefrontRouteNamespaces: list(string),
        allowedUnitTestClassNamespaces: list(string),
        createMockWithoutExpectationsEnabledNamespaces: list(string),
    ])
